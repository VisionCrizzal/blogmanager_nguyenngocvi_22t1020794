@using blogmanager_nguyenngocvi_22t1020794.Models
@model List<Post>

@{
    ViewData["Title"] = "Danh sách bài viết";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>📚 Danh sách bài viết</h1>
    <div>
        <a asp-action="Create" class="btn btn-success me-2">+ Tạo mới</a>
        <span class="badge bg-primary fs-6">Tổng: @Model.Count bài</span>
    </div>
</div>
<hr />

<!-- Sử dụng hệ thống lưới (Grid System) row / col của Bootstrap -->
<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var post in Model)
    {
        <div class="col">
            <!-- Tách biệt code: Gọi Partial View _PostCard và truyền dữ liệu từng bài vào -->
            <partial name="_PostCard" model="post" />
        </div>
    }
</div>