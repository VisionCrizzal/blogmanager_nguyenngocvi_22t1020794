@using blogmanager_nguyenngocvi_22t1020794.Models
@model blogmanager_nguyenngocvi_22t1020794.ViewModels.PostListViewModel

@{
    ViewData["Title"] = "Danh sách bài viết";
}

<h1>Danh sách bài viết</h1>

<!-- Nút Thêm bài viết (chỉ hiện khi đã đăng nhập) -->
@if (User.Identity != null && User.Identity.IsAuthenticated)
{
    <a asp-action="Create" class="btn btn-outline-success mb-3">⊕ Thêm bài viết</a>
}

<!-- Thanh tìm kiếm + Lọc danh mục -->
<form asp-action="Index" method="get" class="row g-2 mb-3 align-items-center">
    <div class="col-auto">
        <select name="categoryId" class="form-select" style="min-width: 180px;">
            <option value="">-- Tất cả danh mục --</option>
            @if (Model.Categories != null)
            {
                @foreach (var cat in Model.Categories)
                {
                    <option value="@cat.Id" selected="@(Model.CategoryId == cat.Id)">@cat.Name</option>
                }
            }
        </select>
    </div>
    <div class="col-auto">
        <select name="tagId" class="form-select" style="min-width: 150px;">
            <option value="">-- Tất cả thẻ --</option>
            @if (Model.Tags != null)
            {
                @foreach (var t in Model.Tags)
                {
                    <option value="@t.Id" selected="@(Model.TagId == t.Id)">@t.Name</option>
                }
            }
        </select>
    </div>
    <div class="col-auto">
        <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Tìm theo tiêu đề..." style="min-width: 200px;" />
    </div>
    <div class="col-auto">
        <select name="sort" class="form-select">
            <option value="">Sắp xếp: Mới nhất (mặc định)</option>
            <option value="oldest" selected="@(Model.Sort == "oldest")">Sắp xếp: Cũ nhất</option>
            <option value="title" selected="@(Model.Sort == "title")">Sắp xếp: Theo tiêu đề</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Tìm</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Bỏ lọc</a>
    </div>
</form>

@if (!string.IsNullOrEmpty(Model.Search) || Model.CategoryId.HasValue || Model.TagId.HasValue || !string.IsNullOrEmpty(Model.Sort))
{
    <p class="text-muted">Tìm thấy <strong>@Model.TotalPosts</strong> kết quả</p>
}

<!-- Bảng danh sách bài viết -->
<div class="table-responsive">
<table class="table table-bordered table-hover">
    <thead class="table-light">
        <tr>
            <th>Tiêu đề</th>
            <th>Danh mục</th>
            <th>Thẻ</th>
            <th>Ngày xuất bản</th>
            <th>Trạng thái</th>
            <th>Hành động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var post in Model.Posts)
        {
            <tr>
                <td>@post.Title</td>
                <td>
                    @if (post.Category != null)
                    {
                        <span class="badge bg-info text-dark">@post.Category.Name</span>
                    }
                </td>
                <td>
                    @if (post.Tags != null && post.Tags.Any())
                    {
                        @foreach (var tag in post.Tags)
                        {
                            <span class="badge bg-warning text-dark me-1">@tag.Name</span>
                        }
                    }
                </td>
                <td>@post.PublishedAt.ToString("dd/MM/yyyy")</td>
                <td>
                    @if (post.IsPublished)
                    {
                        <span class="badge bg-success">🟢 Đang xuất bản</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">📝 Bản nháp</span>
                    }
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@post.Id" class="btn btn-sm btn-outline-info">Xem chi tiết</a>
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <a asp-action="Edit" asp-route-id="@post.Id" class="btn btn-sm btn-outline-warning">✏ Sửa</a>
                    }
                    @using System.Security.Claims
                    @{ var userId = User.FindFirstValue(ClaimTypes.NameIdentifier); }
                    @if (User.IsInRole("Admin") || (post.OwnerId != null && post.OwnerId == userId))
                    {
                        <!-- Nút Xóa bằng Modal (chỉ Admin hoặc Chủ sở hữu) -->
                        <button type="button" class="btn btn-sm btn-outline-danger"
                                data-bs-toggle="modal" data-bs-target="#deleteModal-@post.Id">
                            🗑 Xóa
                        </button>
                    }
                </td>
            </tr>

            <!-- Modal xác nhận xóa -->
            <div class="modal fade" id="deleteModal-@post.Id" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Xác nhận xóa</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            Bạn có chắc chắn muốn xóa bài viết <strong>"@post.Title"</strong> không?
                            <br />Thao tác này không thể hoàn tác.
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                            <form asp-action="Delete" asp-route-id="@post.Id" method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger">Đúng, hãy xóa!</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </tbody>
</table>
</div>

<!-- Phân trang -->
@if (Model.TotalPages > 1)
{
    <nav aria-label="Phân trang">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-search="@Model.Search" asp-route-categoryId="@Model.CategoryId" asp-route-tagId="@Model.TagId" asp-route-sort="@Model.Sort">«</a>
            </li>
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@Model.Search" asp-route-categoryId="@Model.CategoryId" asp-route-tagId="@Model.TagId" asp-route-sort="@Model.Sort">@i</a>
                </li>
            }
            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-search="@Model.Search" asp-route-categoryId="@Model.CategoryId" asp-route-tagId="@Model.TagId" asp-route-sort="@Model.Sort">»</a>
            </li>
        </ul>
    </nav>
}