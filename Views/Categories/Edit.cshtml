@model blogmanager_nguyenngocvi_22t1020794.Models.Category

@{
    ViewData["Title"] = "Chỉnh sửa chuyên mục";
}

<div class="card shadow-sm border-0 bg-glass p-4 mt-4" style="max-width: 500px; margin: 0 auto;">
    <h2>✏️ Chỉnh sửa chuyên mục</h2>
    <hr />

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <div asp-validation-summary="All" class="text-danger fw-bold"></div>
        
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="Name" class="form-label fw-bold"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
        <a asp-action="Index" class="btn btn-outline-secondary ms-2">Hủy</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
